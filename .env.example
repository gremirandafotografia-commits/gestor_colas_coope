# Copie este archivo a ".env" y complete los valores reales.
# NUNCA suba el archivo ".env" (con valores reales) a un repositorio.

# --- Base de datos PostgreSQL ---
DATABASE_URL=postgresql://usuario:clave@localhost:5432/coopelesca_filas
# Póngalo en "true" si su Postgres exige conexión cifrada (frecuente en
# Railway y otros Postgres administrados cuando se usa la URL PÚBLICA en vez
# de la de red privada) — si no, cada consulta falla y el navegador solo ve
# "Error interno del servidor", sin pista de la causa real.
PGSSL=false

# --- Seguridad ---
# Cadena larga y aleatoria para firmar los tokens de sesión (JWT).
# Genérela con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambie-esto-por-una-cadena-aleatoria-larga

# Dominio institucional del correo del personal (se completa automáticamente
# cuando alguien digita solo el usuario, igual que en el prototipo).
DOMINIO_CORREO=@coopelesca.co.cr

# --- Servidor ---
PORT=4000
# Orígenes permitidos para CORS, separados por coma (los dominios/IPs desde
# donde se van a abrir el kiosco, la sala, la ventanilla, etc.)
CORS_ORIGENES=http://localhost:4000

# --- Padrón real de asociados (opcional; se puede configurar también desde
#     Administración → Configuración una vez el sistema esté funcionando) ---
PADRON_URL=
PADRON_TOKEN=
